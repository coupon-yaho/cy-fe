# 쿠폰 API 서버 주소.
#
# 비워 두면 목 어댑터(src/lib/coupon/mock.ts)가 응답합니다.
# 값을 넣으면 같은 계약으로 cy-be 실서버(CY-1)에 붙습니다.
#
# 로컬 실서버 연동은 Vite의 /api 프록시를 거칩니다.
# VITE_ 변수는 브라우저에 노출되므로 비밀값을 넣지 않습니다.
VITE_API_BASE_URL=http://localhost:5173

# 관리자 화면 데이터 원천.
# 비워 두면 기존 프론트 Mock을 사용합니다.
# metrics-live는 시스템 metrics만 HTTP로 보내고 나머지는 기존 프론트 Mock을 유지합니다.
# live는 관리자 API 전체를 VITE_API_BASE_URL로 보냅니다.
# 실제 백엔드 전체 연동은 live를 사용합니다.
VITE_ADMIN_API=live

# ── 개발 서버 프록시 ─────────────────────────────────────────
# 아래 셋은 VITE_ 접두사가 **없습니다.** 브라우저 번들에 안 들어가고
# vite.config 가 개발 서버에서만 읽습니다. 실제 값은 .env.local 에 둡니다.

# 배치 관리 포트(9091) 토큰. 개발 서버가 프록시하면서 X-Batch-Admin-Token 으로 붙입니다.
# 토큰을 브라우저로 내려보내면 관리 API 를 아무나 부를 수 있게 되므로 접두사를 못 씁니다.
# cy-be/.env 와 같은 값이어야 합니다. 비워 두면 관리자 화면의 배치 검증 패널만 빕니다.
BATCH_ADMIN_TOKEN=

# 프록시가 바라볼 곳. 컨테이너 안에서 개발 서버를 띄울 때만 필요합니다 —
# 그때는 localhost 가 컨테이너 자신이라 호스트의 서버에 못 닿습니다.
# 맨몸으로 띄우면 기본값(localhost:8080 / localhost:9091)이 맞습니다.
API_ORIGIN=
BATCH_ORIGIN=

# 대조군 배치. 배치 한 대는 DB_NAME 으로 DB 하나만 보므로, 오염셋과 정상셋을 나란히
# 보여 주려면 배치가 두 대여야 합니다. 안 띄웠으면 비워 두십시오 — 그때 화면은
# 한 셋만 그립니다.
BATCH_ALT_ORIGIN=
